{
  "info": {
    "name": "MindLog EduSmart API",
    "description": "Collection untuk Auth, Journal, Article, Category, Statistics, JWT, Basic Auth, dan API Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Warga Baru\",\n  \"email\": \"warga@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}" },
            "url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) pm.environment.set('token', json.data.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          }
        },
        {
          "name": "Profile",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/profile", "host": ["{{base_url}}"], "path": ["api", "profile"] } }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": { "raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api", "logout"] } }
        }
      ]
    },
    {
      "name": "JOURNAL",
      "item": [
        { "name": "List Journals", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/journals", "host": ["{{base_url}}"], "path": ["api", "journals"] } } },
        {
          "name": "Create Journal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mood_id\": 4,\n  \"title\": \"Belajar Literasi Digital\",\n  \"content\": \"Saya membaca artikel tentang keamanan digital.\",\n  \"journal_date\": \"2026-05-27\",\n  \"is_private\": true\n}" },
            "url": { "raw": "{{base_url}}/api/journals", "host": ["{{base_url}}"], "path": ["api", "journals"] }
          }
        },
        { "name": "Show Journal", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/journals/{{journal_id}}", "host": ["{{base_url}}"], "path": ["api", "journals", "{{journal_id}}"] } } },
        {
          "name": "Update Journal",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Update Jurnal Belajar\"\n}" },
            "url": { "raw": "{{base_url}}/api/journals/{{journal_id}}", "host": ["{{base_url}}"], "path": ["api", "journals", "{{journal_id}}"] }
          }
        },
        { "name": "Delete Journal", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/journals/{{journal_id}}", "host": ["{{base_url}}"], "path": ["api", "journals", "{{journal_id}}"] } } }
      ]
    },
    {
      "name": "ARTICLE CATEGORY STATISTICS",
      "item": [
        { "name": "List Articles", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/articles", "host": ["{{base_url}}"], "path": ["api", "articles"] } } },
        { "name": "Show Article", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/articles/{{article_id}}", "host": ["{{base_url}}"], "path": ["api", "articles", "{{article_id}}"] } } },
        { "name": "List Categories", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/categories", "host": ["{{base_url}}"], "path": ["api", "categories"] } } },
        { "name": "User Statistics", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/statistics", "host": ["{{base_url}}"], "path": ["api", "statistics"] } } }
      ]
    },
    {
      "name": "AUTHORIZATION EXAMPLES",
      "item": [
        {
          "name": "Basic Auth - Statistics",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{email}}", "type": "string" }, { "key": "password", "value": "{{password}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/basic/statistics", "host": ["{{base_url}}"], "path": ["api", "basic", "statistics"] }
          }
        },
        {
          "name": "API Key - Articles",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/key/articles", "host": ["{{base_url}}"], "path": ["api", "key", "articles"] }
          }
        }
      ]
    }
  ]
}
