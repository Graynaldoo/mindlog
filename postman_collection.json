{
  "info": {
    "name": "MindLog Smart Education API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "api_key", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Warga Belajar\",\n  \"email\": \"warga@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@mindlog.test\",\n  \"password\": \"password\"\n}"
        }
      }
    },
    {
      "name": "Auth - Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/profile"
      }
    },
    {
      "name": "Journal - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/journals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mood_id\": 4,\n  \"title\": \"Belajar Literasi Digital\",\n  \"content\": \"Saya membaca artikel keamanan digital.\",\n  \"daily_activities\": \"Membaca artikel, membuat rangkuman, latihan verifikasi informasi.\",\n  \"productivity_score\": 85,\n  \"activity_minutes\": 45,\n  \"journal_date\": \"2026-05-27\",\n  \"is_private\": true\n}"
        }
      }
    },
    {
      "name": "Journal - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/journals"
      }
    },
    {
      "name": "Education - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/education"
      }
    },
    {
      "name": "Education - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/education",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tips Produktivitas Digital\",\n  \"type\": \"tip\",\n  \"excerpt\": \"Langkah singkat belajar konsisten.\",\n  \"content\": \"Catat aktivitas harian, baca sumber tepercaya, dan evaluasi progres.\",\n  \"status\": \"published\",\n  \"estimated_minutes\": 4\n}"
        }
      }
    },
    {
      "name": "Analytics - Statistics",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/statistics"
      }
    },
    {
      "name": "Analytics - Impact",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/impact"
      }
    },
    {
      "name": "Leaderboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/leaderboard"
      }
    },
    {
      "name": "API Key - Generate",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api-keys",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Key\"\n}" }
      }
    },
    {
      "name": "API Key - Validate",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
        "url": "{{base_url}}/key/validate"
      }
    }
  ]
}
