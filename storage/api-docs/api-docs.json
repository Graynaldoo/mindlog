                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mood_id",
                                    "title",
                                    "content",
                                    "journal_date"
                                ],
                                "properties": {
                                    "mood_id": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Belajar Literasi Digital"
                                    },
                                    "content": {
                                        "type": "string",
                                        "example": "Saya membaca artikel keamanan digital."
                                    },
                                    "journal_date": {
                                        "type": "string",
                                        "example": "2026-05-27"
                                    },
                                    "is_private": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Jurnal dibuat"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
